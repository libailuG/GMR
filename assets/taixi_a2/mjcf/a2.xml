<!-- ============================================================
  MuJoCo MJCF for Unitree A2 (Biped Configuration)
  Converted from a2.urdf (SolidWorks export)

  Legs: 2 (right + left), 6 DOF per leg = 12 actuated joints
  Total bodies: 15 (1 base + 2×6 leg + 2 foot)

  Actuators:   12× position-controlled PD motors
  Sensors:     jointpos, jointvel, actuatorfrc (12 each)
               IMU (accelerometer, gyro, framequat, framelinvel, frameangvel)
               foot contact (touch × 2), base world position
  Sites:       3 (IMU + 2 foot contact) + 187 height scanner grid sites

  For sim-to-sim transfer with Isaac Lab / Isaac Gym.
  ============================================================ -->

<mujoco model="a2">

  <!-- ========== Compiler ========== -->
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>

  <!-- ========== Simulation Options ========== -->
  <option timestep="0.005" gravity="0 0 -9.81" iterations="4" ls_iterations="4">
    <flag contact="enable" gravity="enable"/>
  </option>

  <!-- ========== Size Parameters (reference) ========== -->
  <size njmax="500" nconmax="500" nstack="500000"/>

  <!-- ========== Defaults ========== -->
  <default>
    <!-- Joint defaults: all revolute joints are limited -->
    <joint type="hinge" damping="0.2" armature="0.01" limited="true"/>
    <geom friction="0.8 0.5 0.5" solimp="0.998 0.998 0.001" solref="0.02 1"/>
    <motor ctrlrange="-200 200" ctrllimited="false"/>

    <!-- Visual-only geoms (no collision) -->
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>

    <!-- Collision geoms -->
    <default class="collision">
      <geom contype="1" conaffinity="1" group="3"/>
    </default>

    <!-- Leg segment collision cylinders -->
    <default class="leg_col">
      <geom type="cylinder" contype="1" conaffinity="1" group="3"
            rgba="0.4 0.4 0.4 1" solimp="0.998 0.998 0.0001"/>
    </default>

    <!-- Foot collision -->
    <default class="foot_col">
      <geom type="box" contype="1" conaffinity="1" group="3"
            rgba="0.2 0.6 0.2 1" solimp="0.9 0.99 0.0001"/>
    </default>
  </default>

  <!-- ========== Assets ========== -->
  <asset>
    <!-- STL Mesh files for visual rendering -->
    <mesh name="mesh_base"            file="base_link.STL"/>
    <mesh name="mesh_l_hip_roll"      file="left_hip_roll_link.STL"/>
    <mesh name="mesh_l_hip_yaw"       file="left_hip_yaw_link.STL"/>
    <mesh name="mesh_l_hip_pitch"     file="left_hip_pitch_link.STL"/>
    <mesh name="mesh_l_knee"          file="left_knee_link.STL"/>
    <mesh name="mesh_l_ankle_pitch"   file="left_ankle_pitch_link.STL"/>
    <mesh name="mesh_l_ankle_roll"    file="left_ankle_roll_link.STL"/>
    <mesh name="mesh_r_hip_roll"      file="right_hip_roll_link.STL"/>
    <mesh name="mesh_r_hip_yaw"       file="right_hip_yaw_link.STL"/>
    <mesh name="mesh_r_hip_pitch"     file="right_hip_pitch_link.STL"/>
    <mesh name="mesh_r_knee"          file="right_knee_link.STL"/>
    <mesh name="mesh_r_ankle_pitch"   file="right_ankle_pitch_link.STL"/>
    <mesh name="mesh_r_ankle_roll"    file="right_ankle_roll_link.STL"/>
  </asset>

  <asset>
    <!-- Materials -->
    <texture name="texture_plane" type="2d" builtin="checker"
             rgb1="0.2745 0.5098 0.7059" rgb2="0.5294 0.8078 0.9804"
             width="128" height="128"/>
    <material name="material_plane" reflectance="0.0" texture="texture_plane"
              texrepeat="1 1" texuniform="true"/>
    <material name="gray"  rgba="0.3 0.3 0.3 1"/>
    <material name="blue"  rgba="0.0 0.0 1.0 1"/>
    <material name="red"   rgba="1.0 0.0 0.0 1"/>
    <material name="green" rgba="0.0 1.0 0.0 1"/>
    <material name="white" rgba="0.9 0.9 0.9 1"/>
  </asset>

  <!-- ========== Worldbody ========== -->
  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="100 100 0.2"
          material="material_plane" conaffinity="2"/>

    <!-- Lighting -->
    <light directional="true" ambient="0.3 0.3 0.3" pos="30 30 30"
           dir="0 -0.5 -1" diffuse="0.5 0.5 0.5" specular="0.5 0.5 0.5"/>

    <!-- ===== BASE LINK (Root) ===== -->
    <body name="base_link" pos="0 0 1.3" euler="0 0 0">
      <freejoint name="base_free"/>

      <!-- Inertial: CoM offset from body origin (from URDF) -->
      <inertial pos="-0.14464 0 0.63562" mass="1.6082"
                fullinertia="1.6349 1.6777 0.06302 0 0.2309 0"/>

      <!-- Visual (mesh only) -->
      <geom class="visual" type="mesh" mesh="mesh_base" rgba="1 0 0 1"/>

      <!-- Collision: bounding box -->
      <geom class="collision" type="box" size="0.2 0.15 0.75"
            pos="-0.2 0 0.75" rgba="0.5 0.5 0.5 1"/>

      <!-- IMU site (mounted near CoM on base) -->
      <site name="site_imu" pos="-0.1 0 0.6" size="0.02"/>

      <!-- ===== Height Scanner Sites (17×11 grid = 187 rays) =====
           Pattern: GridPatternCfg(resolution=0.1, size=[1.6, 1.0])
           Ray alignment: yaw (rays always point downward in world frame)
           Offset: (0, 0, 20.0) above base_link
           Use with: mujoco.mj_ray() in Python wrapper (see height_scanner.py)
           Grid: X=[-0.8, 0.8], Y=[-0.5, 0.5], step=0.1, Z=20.0
