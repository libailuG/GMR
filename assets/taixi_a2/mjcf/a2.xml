  <!-- ============================================================ -->
  <!--  ACTUATORS                                                   -->
  <!--  Position-controlled PD motors for all 12 revolute joints    -->
  <!--  kp/kv tuned for stable sim-to-sim transfer                  -->
  <!-- ============================================================ -->
  <actuator>

    <position name="act_left_hip_roll"      joint="left_hip_roll_joint"
              ctrlrange="-0.52 2.97"  kp="60.0" kv="0.2" forcerange="-60 60"/>
    <position name="act_left_hip_yaw"       joint="left_hip_yaw_joint"
              ctrlrange="-2.76 2.76"  kp="60.0" kv="0.2" forcerange="-40 40"/>
    <position name="act_left_hip_pitch"     joint="left_hip_pitch_joint"
              ctrlrange="-2.53 2.88"  kp="80.0" kv="0.2" forcerange="-100 100"/>
    <position name="act_left_knee"          joint="left_knee_joint"
              ctrlrange="-0.09 2.88"  kp="80.0" kv="0.2" forcerange="-100 100"/>
    <position name="act_left_ankle_pitch"   joint="left_ankle_pitch_joint"
              ctrlrange="-0.87 0.52"  kp="40.0" kv="0.2" forcerange="-20 20"/>
    <position name="act_left_ankle_roll"    joint="left_ankle_roll_joint"
              ctrlrange="-0.26 0.26"  kp="40.0" kv="0.2" forcerange="-20 20"/>


    <position name="act_right_hip_roll"     joint="right_hip_roll_joint"
              ctrlrange="-2.97 0.52"  kp="60.0" kv="0.1" forcerange="-60 60"/>
    <position name="act_right_hip_yaw"      joint="right_hip_yaw_joint"
              ctrlrange="-2.76 2.76"  kp="60.0" kv="0.2" forcerange="-40 40"/>
    <position name="act_right_hip_pitch"    joint="right_hip_pitch_joint"
              ctrlrange="-2.53 2.88"  kp="80.0" kv="0.2" forcerange="-100 100"/>
    <position name="act_right_knee"         joint="right_knee_joint"
              ctrlrange="-0.09 2.88"  kp="80.0" kv="0.2" forcerange="-100 100"/>
    <position name="act_right_ankle_pitch"  joint="right_ankle_pitch_joint"
              ctrlrange="-0.87 0.52"  kp="40.0" kv="0.2" forcerange="-20 20"/>
    <position name="act_right_ankle_roll"   joint="right_ankle_roll_joint"
              ctrlrange="-0.26 0.26"  kp="40.0" kv="0.2" forcerange="-20 20"/>
  </actuator>

  <!-- ============================================================ -->
  <!--  SENSORS                                                     -->
  <!--  Full sensor suite for sim-to-sim RL transfer:               -->
  <!--    - Joint positions (12)                                    -->
  <!--    - Joint velocities (12)                                   -->
  <!--    - Actuator forces/torques (12)                            -->
  <!--    - Base IMU: accel, gyro, quat, linvel, angvel             -->
  <!--    - Foot contact (2)                                        -->
  <!--    - Base world position                                     -->
  <!-- ============================================================ -->
  <sensor>
    <!-- ===== Joint Position Sensors ===== -->
    <jointpos name="sen_left_hip_roll_pos"      joint="left_hip_roll_joint"/>
    <jointpos name="sen_left_hip_yaw_pos"       joint="left_hip_yaw_joint"/>
    <jointpos name="sen_left_hip_pitch_pos"     joint="left_hip_pitch_joint"/>
    <jointpos name="sen_left_knee_pos"          joint="left_knee_joint"/>
    <jointpos name="sen_left_ankle_pitch_pos"   joint="left_ankle_pitch_joint"/>
    <jointpos name="sen_left_ankle_roll_pos"    joint="left_ankle_roll_joint"/>

    <jointpos name="sen_right_hip_roll_pos"     joint="right_hip_roll_joint"/>
    <jointpos name="sen_right_hip_yaw_pos"      joint="right_hip_yaw_joint"/>
    <jointpos name="sen_right_hip_pitch_pos"    joint="right_hip_pitch_joint"/>
    <jointpos name="sen_right_knee_pos"         joint="right_knee_joint"/>
    <jointpos name="sen_right_ankle_pitch_pos"  joint="right_ankle_pitch_joint"/>
    <jointpos name="sen_right_ankle_roll_pos"   joint="right_ankle_roll_joint"/>

    <!-- ===== Joint Velocity Sensors ===== -->
    <jointvel name="sen_left_hip_roll_vel"      joint="left_hip_roll_joint"/>
    <jointvel name="sen_left_hip_yaw_vel"       joint="left_hip_yaw_joint"/>
    <jointvel name="sen_left_hip_pitch_vel"     joint="left_hip_pitch_joint"/>
    <jointvel name="sen_left_knee_vel"          joint="left_knee_joint"/>
    <jointvel name="sen_left_ankle_pitch_vel"   joint="left_ankle_pitch_joint"/>
    <jointvel name="sen_left_ankle_roll_vel"    joint="left_ankle_roll_joint"/>

    <jointvel name="sen_right_hip_roll_vel"     joint="right_hip_roll_joint"/>
    <jointvel name="sen_right_hip_yaw_vel"      joint="right_hip_yaw_joint"/>
    <jointvel name="sen_right_hip_pitch_vel"    joint="right_hip_pitch_joint"/>
    <jointvel name="sen_right_knee_vel"         joint="right_knee_joint"/>
    <jointvel name="sen_right_ankle_pitch_vel"  joint="right_ankle_pitch_joint"/>
    <jointvel name="sen_right_ankle_roll_vel"   joint="right_ankle_roll_joint"/>

    <!-- ===== Actuator Force/Torque Sensors ===== -->
    <actuatorfrc name="sen_left_hip_roll_trq"      actuator="act_left_hip_roll"/>
    <actuatorfrc name="sen_left_hip_yaw_trq"       actuator="act_left_hip_yaw"/>
    <actuatorfrc name="sen_left_hip_pitch_trq"     actuator="act_left_hip_pitch"/>
    <actuatorfrc name="sen_left_knee_trq"          actuator="act_left_knee"/>
    <actuatorfrc name="sen_left_ankle_pitch_trq"   actuator="act_left_ankle_pitch"/>
    <actuatorfrc name="sen_left_ankle_roll_trq"    actuator="act_left_ankle_roll"/>

    <actuatorfrc name="sen_right_hip_roll_trq"     actuator="act_right_hip_roll"/>
    <actuatorfrc name="sen_right_hip_yaw_trq"      actuator="act_right_hip_yaw"/>
    <actuatorfrc name="sen_right_hip_pitch_trq"    actuator="act_right_hip_pitch"/>
    <actuatorfrc name="sen_right_knee_trq"         actuator="act_right_knee"/>
    <actuatorfrc name="sen_right_ankle_pitch_trq"  actuator="act_right_ankle_pitch"/>
    <actuatorfrc name="sen_right_ankle_roll_trq"   actuator="act_right_ankle_roll"/>

    <!-- ===== Base IMU Sensors (body frame) ===== -->
    <framequat    name="sen_base_quat"    objtype="body" objname="base_link"/>
    <framelinvel  name="sen_base_linvel"  objtype="body" objname="base_link"/>
    <frameangvel  name="sen_base_angvel"  objtype="body" objname="base_link"/>
    <framepos     name="sen_base_pos"     objtype="body" objname="base_link"/>
    <accelerometer name="sen_base_accel"  site="site_imu"/>
    <gyro          name="sen_base_gyro"   site="site_imu"/>

    <!-- ===== Foot Contact Sensors ===== -->
    <touch name="sen_left_foot_contact"  site="site_l_foot"/>
    <touch name="sen_right_foot_contact" site="site_r_foot"/>
  </sensor>

</mujoco>
